{
  "bucketId": "<log-bucket-id>",
  "eventNotificationRules": [
    {
      "name": "describe-on-split",
      "eventTypes": ["b2:ObjectCreated:Upload", "b2:ObjectCreated:MultipartUpload"],
      "objectNamePrefix": "bags/",
      "isEnabled": true,
      "maxEventsPerBatch": 1,
      "targetConfiguration": {
        "targetType": "webhook",
        "url": "https://hooks.example.com/b2/describe",
        "hmacSha256SigningSecret": "<32-char-alphanumeric-secret>"
      }
    }
  ]
}
